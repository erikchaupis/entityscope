<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
  "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
  <session-factory>
    <property name="connection.driver_class">org.h2.Driver</property>
    <property name="connection.url">jdbc:h2:mem:entityviewer</property>
    <property name="dialect">org.hibernate.dialect.H2Dialect</property>
    <property name="show_sql">true</property>

    <mapping resource="mappings/User.hbm.xml"/>
    <mapping resource="mappings/Address.hbm.xml"/>
    <mapping resource="mappings/Order.hbm.xml"/>
    <mapping resource="mappings/OrderItem.hbm.xml"/>
    <mapping resource="mappings/Payment.hbm.xml"/>
    <mapping resource="mappings/Invoice.hbm.xml"/>
    <mapping resource="mappings/Product.hbm.xml"/>
    <mapping resource="mappings/Category.hbm.xml"/>
    <mapping resource="mappings/Warehouse.hbm.xml"/>
  </session-factory>
</hibernate-configuration>
