<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="com.entityviewer.inventory.Product" table="PRODUCTS">
    <id name="id" column="PRODUCT_ID" type="long">
      <generator class="native"/>
    </id>
    <property name="sku" column="SKU" type="string" not-null="true"/>
    <property name="name" column="NAME" type="string"/>
    <property name="price" column="PRICE" type="big_decimal"/>

    <many-to-one name="warehouse" class="com.entityviewer.inventory.Warehouse" column="WAREHOUSE_ID"/>

    <set name="categories" table="PRODUCT_CATEGORY" cascade="all">
      <key column="PRODUCT_ID"/>
      <many-to-many class="com.entityviewer.inventory.Category" column="CATEGORY_ID"/>
    </set>
  </class>
</hibernate-mapping>
