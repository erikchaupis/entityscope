<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  <class name="com.entityviewer.inventory.Category" table="CATEGORIES">
    <id name="id" column="CATEGORY_ID" type="long">
      <generator class="native"/>
    </id>
    <property name="name" column="NAME" type="string" not-null="true"/>
    <property name="description" column="DESCRIPTION" type="string"/>

    <set name="products" table="PRODUCT_CATEGORY" inverse="true">
      <key column="CATEGORY_ID"/>
      <many-to-many class="com.entityviewer.inventory.Product" column="PRODUCT_ID"/>
    </set>
  </class>
</hibernate-mapping>
